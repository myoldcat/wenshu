# Copy this template to a private file outside the repository.
WENSHU_COMPOSE_PROJECT=wenshu
WENSHU_FRONTEND_HOST=127.0.0.1
WENSHU_FRONTEND_PORT=4173
WENSHU_API_PORT=8787
WENSHU_RERANK_PORT=8788
WENSHU_RERANK_URL=http://127.0.0.1:8788
WENSHU_ALLOWED_HOSTS=
WENSHU_ALLOWED_ORIGINS=
WENSHU_OPERATIONS_ALLOWED_HOSTS=
WENSHU_UID=1000
WENSHU_GID=1000
